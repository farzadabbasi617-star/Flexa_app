# ===================== HaghBaKie Bot - Environment Variables =====================
# این فایل را به .env تغییر نام دهید و مقادیر را پر کنید

# توکن بات تلگرام (از @BotFather)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# رشته اتصال PostgreSQL (Neon)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# کلید API هوش مصنوعی Groq
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY

# پورت سرور (Render خودکار تنظیم می‌کند)
PORT=8000

# آدرس سرور برای Webhook
BASE_URL=https://your-app.onrender.com

# آیدی عددی مالک بات
OWNER_ID=248175860
